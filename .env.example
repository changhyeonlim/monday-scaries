# Reference list of the environment variables Monday Scaries reads.
# Set real values in your shell environment or in
# ~/.monday_scaries/config.toml. Never put real keys in this folder.
#
# You only need the key for the provider you use.

# Optional. Raises the GitHub API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Which provider to use: openai | claude | gemini | groq | openrouter | custom
# The --provider flag overrides this.
MONDAY_SCARIES_PROVIDER=

# Optional. Overrides the provider's default model.
MONDAY_SCARIES_MODEL=

# Provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Custom OpenAI-compatible endpoint, e.g. Ollama at http://localhost:11434/v1
MONDAY_SCARIES_CUSTOM_BASE_URL=
# Optional. Ollama doesn't need a key.
MONDAY_SCARIES_CUSTOM_API_KEY=